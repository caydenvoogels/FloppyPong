# Normalize text files for cross-platform Unreal development.
* text=auto

# Unreal project and config files
*.uproject text eol=lf
*.uplugin text eol=lf
*.ini text eol=crlf
*.uprojectdirs text eol=lf
*.target text eol=lf
*.build.cs text eol=lf
*.target.cs text eol=lf

# Source files
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.usf text eol=lf
*.ush text eol=lf

# Unreal binary assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.utoc filter=lfs diff=lfs merge=lfs -text
*.ucas filter=lfs diff=lfs merge=lfs -text

